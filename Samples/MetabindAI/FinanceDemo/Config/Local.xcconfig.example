// Copy this file to Local.xcconfig (same directory) and fill in your own
// values for a local device or TestFlight build. Local.xcconfig is
// gitignored — it never gets committed or published, so this is the safe
// place for real signing and project identity values.
//
// FINANCE_DEMO_API_KEY is optional for a local build. If set, it is compiled
// into Info.plist and is recoverable from the built app; use only a restricted,
// revocable demo key. Leave it empty to enter a key at runtime instead.
FINANCE_DEMO_BUNDLE_ID = com.yourcompany.MetabindFinanceDemo
FINANCE_DEMO_ORG_ID = your_org_id
FINANCE_DEMO_PROJECT_ID = your_project_id
FINANCE_DEMO_API_KEY = your_api_key
DEVELOPMENT_TEAM = YOUR_TEAM_ID
